# AtmosFlow — environment variables
#
# Every variable read by api/, lib/, scripts/, server/ and vite.config.js.
# docs/ENVIRONMENT.md has the same list with the file that reads each one.
# `npm run check:env` lists the required server variables that are missing.
#
# VITE_* values are baked into the browser bundle at build time and are
# public. Everything else is a server secret: never give it a VITE_ prefix.

# ── Client / public (build time) ────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL (also the server fallback for SUPABASE_URL)
VITE_SUPABASE_ANON_KEY=eyJ...                        # Supabase anon/publishable key; also used server-side to verify user JWTs
VITE_SENTRY_DSN=                                     # Browser Sentry DSN; empty = client error reporting off
VITE_GIT_COMMIT_SHA=                                 # Release tag for client Sentry events (CI sets it)
VITE_BILLING_MODE=beta                               # beta (default) or live — flips paid-plan gating on

# ── Server (runtime, required) ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co        # Supabase project URL for every /api handler
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # Service-role key — bypasses RLS; server only
ANTHROPIC_API_KEY=sk-ant-...                         # Claude API key for narrative, inline AI, Jasper, photo analysis
CRON_SECRET=                                         # Bearer token the scheduler sends to /api/cron-*; unset = 503 (fail closed)

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...                        # Stripe secret key (sk_live_ in production)
STRIPE_WEBHOOK_SECRET=whsec_...                      # Signing secret for /api/webhook
STRIPE_PRICE_SOLO_MONTHLY=                           # Price id — Solo, monthly
STRIPE_PRICE_SOLO_ANNUAL=                            # Price id — Solo, annual
STRIPE_PRICE_PRO_MONTHLY=                            # Price id — Pro, monthly
STRIPE_PRICE_PRO_ANNUAL=                             # Price id — Pro, annual
STRIPE_PRICE_PRACTICE_MONTHLY=                       # Price id — Practice, monthly
STRIPE_PRICE_PRACTICE_ANNUAL=                        # Price id — Practice, annual

# ── Email ───────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                                # Resend API key (early access, peer review, email queue, marketing agent)
RESEND_FROM_ADDRESS=                                 # From address for outbound email; each sender has its own default

# ── Cron / admin / entitlement ──────────────────────────────────────────
ADMIN_SECRET=                                        # Bearer secret for /api/admin
UNLIMITED_USAGE_EMAILS=                              # Comma-separated emails that bypass AI rate limits

# ── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=                                          # Server Sentry DSN; empty = no-op
VERCEL_GIT_COMMIT_SHA=                               # Release tag (Vercel sets this automatically)
GIT_COMMIT_SHA=                                      # Release tag outside Vercel (CI, Docker)
GIT_COMMIT=                                          # Older fallback for the Sentry release tag
VERCEL_ENV=                                          # production / preview / development (Vercel sets it)
NODE_ENV=development                                 # Environment fallback for Sentry; the container image sets production
PORT=8080                                            # Container listen port (server/index.js)

# ── Scripts only (never set on the deployment) ──────────────────────────
SUPABASE_DB_URL=                                     # Postgres URI for scripts/db-migrate.mjs (CI secret)
DATABASE_URL=                                        # Fallback for SUPABASE_DB_URL
SMOKE_TEST_BASE_URL=https://atmosflow.app            # Deployment probed by scripts/smoke-test-production.ts
STRIPE_TEST_SECRET_KEY=sk_test_...                   # Smoke test only; must start with sk_test_
SMOKE_TEST_ALERT_EMAIL=                              # Smoke-test failure alert recipient (via Resend)
SLACK_WEBHOOK_URL=                                   # Smoke-test failure alert channel
SUPABASE_REDIRECT_URL=                               # scripts/verify-password-reset.ts redirect target
PASSWORD_RESET_TEST_EMAIL_SEED=                      # scripts/verify-password-reset.ts throwaway-account seed
