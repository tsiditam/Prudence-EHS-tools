{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD .",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/report-pdf.js": { "maxDuration": 60, "memory": 2048 },
    "api/report-templates-render.ts": { "maxDuration": 60, "memory": 1024 },
    "api/cron-portfolio-digest.ts": { "maxDuration": 300 },
    "api/cron-calibration-expiry.ts": { "maxDuration": 120 },
    "api/cron-email-queue-processor.ts": { "maxDuration": 120 },
    "api/cron-monthly-credit-grant.ts": { "maxDuration": 120 },
    "api/cron-free-tier-reset.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-free-tier-reset",       "schedule": "0 0 * * *" },
    { "path": "/api/cron-monthly-credit-grant",  "schedule": "0 0 1 * *" },
    { "path": "/api/cron-email-queue-processor", "schedule": "*/15 * * * *" },
    { "path": "/api/cron-calibration-expiry",    "schedule": "0 13 * * *" },
    { "path": "/api/cron-portfolio-digest",      "schedule": "0 13 1 1,4,7,10 *" }
  ]
}
