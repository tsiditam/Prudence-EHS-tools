{
  "name": "atmosiq-v6",
  "version": "6.0.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "npm run lint:eslint && npm run lint:src && npm run lint:imports",
    "lint:eslint": "eslint --max-warnings=0 \"scripts/**/*.{js,mjs,ts}\" \"tests/api/**/*.ts\" \"tests/scripts/**/*.ts\" \"tests/components/**/*.{ts,tsx}\" \"tests/lib/**/*.ts\" \"tests/pages/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"components/**/*.{ts,tsx}\" \"pages/**/*.{ts,tsx}\"",
    "lint:src": "eslint --max-warnings=__RATCHET__ \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:imports": "node scripts/check-api-js-imports.mjs",
    "accept:api-boot": "node scripts/acceptance-check.mjs --config scripts/acceptance/api-boot.json",
    "accept:prod-ready": "node scripts/acceptance-check.mjs --config scripts/acceptance/prod-ready.json",
    "accept:pricing-rollout": "node scripts/acceptance-check.mjs --config scripts/acceptance/pricing-rollout.json",
    "accept:go-live": "node scripts/acceptance-check.mjs --config scripts/acceptance/go-live.json",
    "accept:jasper-eval": "node scripts/eval-jasper.mjs --config scripts/acceptance/jasper-eval.json",
    "test:kg": "vitest run tests/services/knowledgeGraphBuilder.test.ts tests/services/knowledgeGraphService.test.ts tests/lib/graphContext.test.ts tests/lib/featureFlags.test.ts tests/components/EvidenceMap.test.tsx tests/components/ReportTraceabilityCard.test.tsx tests/components/DevPreviewButton.test.tsx tests/components/KnowledgeGraphView.test.tsx tests/engine/sections-traceability.test.ts",
    "accept:kg": "node scripts/acceptance-check.mjs --config scripts/acceptance/kg.json",
    "test:mold": "vitest run tests/engine/mold-engine.test.ts tests/engine/mold-standards.test.ts tests/engine/mold-intake.test.ts tests/engine/mold-report.test.ts tests/lib/moldFeatureFlags.test.ts tests/lib/moldStorage.test.ts tests/components/MoldScreeningView.test.tsx tests/components/MoldPreviewButton.test.tsx tests/components/MoldModeScreen.test.tsx",
    "accept:mold": "node scripts/acceptance-check.mjs --config scripts/acceptance/mold.json",
    "render:kg-sample": "RENDER_KG_SAMPLE=1 vitest run scripts/dev/render-kg-traceability-sample.test.ts",
    "bundle:api": "node scripts/bundle-api.mjs",
    "check:env": "node scripts/check-env.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:status": "node scripts/db-migrate.mjs --dry-run"
  },
  "dependencies": {
    "@sentry/node": "^8.55.0",
    "@sentry/react": "^8.55.0",
    "@supabase/supabase-js": "^2.101.1",
    "dayjs": "^1.11.20",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.18.0",
    "pizzip": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.1.0",
    "recharts": "^3.8.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cheerio": "^1.2.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "pg": "^8.13.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.2"
  }
}
